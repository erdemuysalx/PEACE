# ============================================================================
# PEACE — Configuration
# Copy this file to .env and set your configuration values.
# ============================================================================
# This file contains all configuration (endpoints, models, runtime parameters). 
# Settings are loaded from this file via pydantic-settings.
# ============================================================================

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_NAME=PEACE
AGENT_MAX_REPLAN_DEPTH=2
AGENT_ENABLE_MEMORY=true
AGENT_MEMORY_WINDOW=6

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_ENDPOINT=https://ollama.com
OLLAMA_API_KEY=                          # leave empty for local instances

# ── Language model ────────────────────────────────────────────────────────────
LANGUAGE_MODEL=nemotron-3-super
LANGUAGE_MODEL_TEMPERATURE=0.7
LANGUAGE_MODEL_NUM_PREDICT=2000
LANGUAGE_MODEL_TIMEOUT=120

# ── Vision model (VLM backend) ────────────────────────────────────────────────
VISION_MODEL=llava:13b
VISION_MODEL_TEMPERATURE=0.1
VISION_MODEL_NUM_PREDICT=800
VISION_MODEL_TIMEOUT=120
VISION_INFERENCE_RATE=0.2                # Hz — how often to run detection
VISION_CONFIDENCE_THRESHOLD=0.6          # 0.0–1.0

# ── YOLO backend (alternative to VLM) ────────────────────────────────────────
USE_YOLO=True
YOLO_MODEL=yolov8n.pt                    # model name or path to .pt file
YOLO_DEVICE=cpu                          # cpu | cuda | mps
YOLO_CONFIDENCE_THRESHOLD=0.5

# ── Depth ─────────────────────────────────────────────────────────────────────
MIN_DEPTH=0.1                            # metres
MAX_DEPTH=50.0                           # metres

# ── ROS 2 / MAVROS topics ──────────────────────────────────────────────────────
NODE_NAMESPACE=peace
TOPIC_NAMESPACE=/mavros
TOPIC_IMU=/mavros/imu/data
TOPIC_ALTITUDE=/mavros/altitude
TOPIC_ODOM=/mavros/local_position/odom
TOPIC_GLOBAL_POSITION=/mavros/global_position/global
TOPIC_CAMERA_INFO=/camera/color/camera_info
TOPIC_CAMERA_COLOR_IMAGE=/camera/color/image
TOPIC_CAMERA_DEPTH_IMAGE=/camera/depth/image
TOPIC_CAMERA_DEPTH_POINTS=/camera/depth/points
TOPIC_LIDAR_SCAN=/lidar/scan

# ── Action / safety ───────────────────────────────────────────────────────────
ACTION_ENABLE_CONTROL=true               # set true to enable flight commands
ACTION_MIN_ALTITUDE=0.5                  # metres
ACTION_MAX_ALTITUDE=50.0                 # metres
ACTION_HORIZONTAL_LIMIT=100.0            # metres from home (±x and ±y)
ACTION_COMMAND_TIMEOUT=30.0              # seconds
ACTION_SETPOINT_STREAM_RATE=10.0         # Hz (must be >= 2 for OFFBOARD mode)
ACTION_STATUS_TIMER_INTERVAL=5.0         # seconds

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_ENABLE=true
LOG_OUTPUT_DIR=./logs

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_SAVE_IMAGES=false
DEBUG_OUTPUT_DIR=./debug_images
